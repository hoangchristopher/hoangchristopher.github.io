---
import { getFeaturedProjects } from "../../../data/projects";

const featuredProjects = getFeaturedProjects();
---

<section class="card-base z-10 px-6 md:px-9 py-6 relative w-full mb-8">
  <div class="mb-6">
    <h2
      class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-black/90 dark:text-white/90"
    >
      Hello!
    </h2>
    <p class="text-lg text-black/60 dark:text-white/60 mt-2">
      I am a 3rd year Electrical Engineering and Computer Science student at UC
      Berkeley interested in software engineering, and I'm currently involved in
      visual computing and machine learning research.
    </p>
    <p class="text-lg text-black/60 dark:text-white/60 mt-2">
      Most recently, I've worked with backend development and CI/CD pipelines,
      but also have experience with React, Node.js, and modern web technologies.
      I'm always eager to learn new things and take on challenging projects.
    </p>
  </div>

  {
    featuredProjects.length > 0 && (
      <div class="mb-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-2xl font-bold text-black/90 dark:text-white/90">
            Featured Projects
          </h3>
          <a
            href="/projects/"
            class="text-sm font-medium text-[var(--primary)] hover:opacity-80 transition"
          >
            View All Projects →
          </a>
        </div>

        <div class="relative">
          <div class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth scrollbar-thin">
            {featuredProjects.map((project) => (
              <article class="min-w-[85%] md:min-w-[48%] lg:min-w-[42%] snap-start card-base overflow-hidden border border-black/5 dark:border-white/10">
                {project.image && (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-56 object-cover"
                  />
                )}

                <div class="p-5">
                  <div class="flex items-start justify-between gap-3 mb-3">
                    <h4 class="text-xl font-bold text-black/90 dark:text-white/90">
                      {project.title}
                    </h4>

                    {project.status && (
                      <span class="shrink-0 rounded-full px-3 py-1 text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300">
                        {project.status}
                      </span>
                    )}
                  </div>

                  {project.description && (
                    <p class="text-black/60 dark:text-white/60 mb-4 line-clamp-3">
                      {project.description}
                    </p>
                  )}

                  {project.techStack && project.techStack.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {project.techStack.slice(0, 4).map((tech) => (
                        <span class="px-2 py-1 rounded-md text-xs bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">
                          {tech}
                        </span>
                      ))}
                    </div>
                  )}

                  {project.tags && project.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-5">
                      {project.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-1 rounded-md text-xs bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <a
                    href={project.visitUrl || "/projects/"}
                    class="inline-flex items-center rounded-xl px-4 py-2 bg-[var(--primary)] text-white font-medium hover:opacity-90 transition"
                  >
                    Visit Project
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>
